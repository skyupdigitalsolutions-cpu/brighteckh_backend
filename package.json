{
  "name": "brightech-jms",
  "version": "0.1.0",
  "description": "Brightech Job Management System — backend (NestJS + Fastify + PostgreSQL)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "ts-node db/migrate.ts",
    "db:check": "psql \"$DATABASE_URL\" -f db/checks/staging_catalog_check.sql",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:sync": "npm run db:migrate && npm run db:pull && npm run db:generate",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:integrity": "jest --runInBand",
    "swagger:schemas": "node --env-file=.env scripts/gen-response-schemas.js",
    "test:clean": "node --env-file=.env scripts/test-clean.js",
    "seed:demo-job": "node --env-file=.env scripts/seed-demo-job.js",
    "seed:demo-purchase": "node --env-file=.env scripts/seed-demo-purchase.js",
    "seed:demo-stores": "node --env-file=.env scripts/seed-demo-stores.js",
    "seed:demo-mis": "node --env-file=.env scripts/seed-demo-mis.js"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.4",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}

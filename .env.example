# --- LOCAL BUILD (Docker Postgres) ---
# This is what you use while developing. Fresh, empty, throwaway.
DATABASE_URL="postgresql://brightech:brightech@localhost:5433/brightech_jms?schema=public"

# App
PORT=3000
NODE_ENV=development

# Dashboard/Swagger: on by default in dev; set true to force-enable in prod
ENABLE_DASHBOARD=true

# --- AUTH ---
# Required. Random, >= 32 chars, different per environment. e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional (defaults shown). Lifetimes are technical defaults pending client sign-off.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=12
# Dev/staging only: password the dashboard seed gives demo employees (DEMO-*, EMP-*).
# Leave empty in production -- then the seed creates no logins.
DEMO_LOGIN_PASSWORD=

# File uploads (POST /api/uploads). Bytes are stored on this host's disk.
# UPLOAD_DIR defaults to ./storage/uploads; UPLOAD_MAX_BYTES defaults to 26214400 (25 MB).
UPLOAD_DIR=
UPLOAD_MAX_BYTES=

# --- DEPLOY (Brightech server) — DO NOT fill during build ---
# At deploy only: point DATABASE_URL at Brightech's Postgres and run a
# reviewed versioned migration. NEVER run db/migrations against a populated DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model migrations {
  filename   String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("_migrations")
}

model activity_audit_log {
  id             BigInt         @id @default(autoincrement())
  company_id     String         @db.Uuid
  actor_id       String?        @db.Uuid
  entity_table   String         @db.VarChar(60)
  entity_id      String         @db.Uuid
  action         String         @db.VarChar(70)
  changed_at     DateTime       @default(now()) @db.Timestamptz(6)
  before_state   Json?
  after_state    Json?
  employees      employees?     @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legal_entities legal_entities @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assemblies {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assembly_code           String                    @unique @db.VarChar(32)
  assembly_name           String                    @db.VarChar(250)
  status                  String                    @default("PENDING_APPROVAL") @db.VarChar(24)
  repairable              Boolean                   @default(true)
  saleable                Boolean                   @default(false)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  inward_equipment_groups inward_equipment_groups[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model auth_events {
  id                 BigInt          @id @default(autoincrement())
  event_type         String          @db.VarChar(30)
  login_id_attempted String?         @db.VarChar(120)
  employee_id        String?         @db.Uuid
  company_id         String?         @db.Uuid
  reason             String?         @db.VarChar(60)
  ip_address         String?         @db.VarChar(64)
  user_agent         String?         @db.VarChar(300)
  occurred_at        DateTime        @default(now()) @db.Timestamptz(6)
  legal_entities     legal_entities? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees          employees?      @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employee_id, occurred_at(sort: Desc)], map: "auth_events_employee")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model auth_refresh_tokens {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id               String                @db.Uuid
  family_id                 String                @db.Uuid
  token_hash                String                @unique @db.Char(64)
  issued_at                 DateTime              @default(now()) @db.Timestamptz(6)
  expires_at                DateTime              @db.Timestamptz(6)
  revoked_at                DateTime?             @db.Timestamptz(6)
  revoked_reason            String?               @db.VarChar(30)
  replaced_by_id            String?               @db.Uuid
  employees                 employees             @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_refresh_tokens       auth_refresh_tokens?  @relation("auth_refresh_tokensToauth_refresh_tokens", fields: [replaced_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_auth_refresh_tokens auth_refresh_tokens[] @relation("auth_refresh_tokensToauth_refresh_tokens")

  @@index([family_id], map: "auth_refresh_tokens_family")
}

model br03_custody_acknowledgements {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id             String                 @db.Uuid
  job_id                 String                 @db.Uuid
  assignment_id          String                 @db.Uuid

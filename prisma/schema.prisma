  condition_note         String?
  job_assignments        job_assignments        @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legal_entities         legal_entities         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees              employees              @relation(fields: [engineer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service_jobs           service_jobs           @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inward_equipment_units inward_equipment_units @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assignment_id, unit_id])
